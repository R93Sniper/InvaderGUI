<Application x:Class="InvaderGui.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <Style TargetType="Window">
            <Setter Property="Background" Value="#353538" />
            <Setter Property="Foreground" Value="#EEEEEE" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="GroupBox"><Setter Property="Foreground" Value="#EEEEEE" /><Setter Property="BorderBrush" Value="#777777" /></Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#555557" /><Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#727275" /><Setter Property="Padding" Value="8,3" /><Setter Property="Margin" Value="2" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#68686B" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#D0D0D0" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#232325" /><Setter Property="Foreground" Value="#F0F0F0" />
            <Setter Property="CaretBrush" Value="White" /><Setter Property="BorderBrush" Value="#777777" /><Setter Property="Padding" Value="3" />
        </Style>
        <Style TargetType="ListBox"><Setter Property="Background" Value="#29292B" /><Setter Property="Foreground" Value="#F0F0F0" /><Setter Property="BorderBrush" Value="#777777" /></Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="7,4" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Chrome" Background="#454548" BorderBrush="#606063" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#68686C" /></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#C0C0C0" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#111111" /><Setter Property="MinHeight" Value="24" /><Setter Property="Margin" Value="2" /></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EEEEEE" /></Style>
    </Application.Resources>
</Application>
