<Window x:Class="InvaderGui.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Invader GUI" Height="720" Width="960" Style="{StaticResource {x:Type Window}}"
        MinHeight="520" MinWidth="780" Loaded="OnLoaded" Closing="OnClosing">
    <Grid Margin="10">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <GroupBox Header="Tools" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="190" MinWidth="150" MaxWidth="360" /><ColumnDefinition Width="7" /><ColumnDefinition MinWidth="420" /></Grid.ColumnDefinitions>
                <ListBox x:Name="TaskList" ItemsSource="{Binding Navigation}" DisplayMemberPath="Label" SelectionChanged="TaskSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#454548" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" DragCompleted="SidebarResized" ToolTip="Drag left or right to resize the tools sidebar." />
                <Border Grid.Column="2" Background="#222222" BorderBrush="#666666" BorderThickness="1" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid Margin="0,0,0,5">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition x:Name="AssetTagFolderColumn" Width="0" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="TaskHeading" FontWeight="SemiBold" Margin="3,0,0,3" />
                            <ContentControl x:Name="RefactorTagFolderHost" Grid.Column="1" Margin="6,0,0,0" Visibility="Collapsed" />
                            <TextBlock x:Name="AssetTagFolderLabel" Grid.Column="1" Text="Tag folder" Margin="9,0,0,3" Visibility="Collapsed" />
                            <ComboBox x:Name="OperationSelector" Grid.Row="1" DisplayMemberPath="Name" SelectionChanged="OperationSelected" Visibility="Collapsed" ToolTip="Choose an operation within this tools tab." />
                            <ContentControl x:Name="AssetTagFolderHost" Grid.Row="1" Grid.Column="1" Margin="6,0,0,0" Visibility="Collapsed" />
                        </Grid>
                        <ScrollViewer x:Name="PlaceholderScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <GroupBox Header="Editing kit paths" Padding="10" Margin="0,10,0,10">
                                    <StackPanel><TextBlock x:Name="ProfileSummary" TextWrapping="Wrap" /><Button Content="Editing kit paths…" HorizontalAlignment="Left" Click="ManageProfiles" Margin="0,8,0,0" /></StackPanel>
                                </GroupBox>
                                <GroupBox Header="Operation" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock x:Name="OperationDescription" TextWrapping="Wrap" Margin="0,0,0,10" />
                                        <TextBlock x:Name="OperationStatus" TextWrapping="Wrap" Margin="0,0,0,8" />
                                        <TextBlock x:Name="PhaseNotice" TextWrapping="Wrap" />
                                    </StackPanel>
                                </GroupBox>
                                <TextBlock x:Name="BusyStatus" TextWrapping="Wrap" Margin="0,4,0,8" />
                            </StackPanel>
                        </ScrollViewer>
                        <ScrollViewer x:Name="BuildMapScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"><ContentControl x:Name="BuildMapHost" /></ScrollViewer>
                        <ScrollViewer Grid.Row="2" x:Name="BuildMapStatusScroll" MaxHeight="72" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"><ContentControl x:Name="BuildMapStatusHost" /></ScrollViewer>
                        <ScrollViewer x:Name="TagHandlingScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"><ContentControl x:Name="TagHandlingHost" /></ScrollViewer>
                        <ScrollViewer x:Name="TagHandlingStatusScroll" Grid.Row="2" MaxHeight="72" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"><ContentControl x:Name="TagHandlingStatusHost" /></ScrollViewer>
                        <ScrollViewer x:Name="ToolFormScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"><ContentControl x:Name="ToolFormHost" /></ScrollViewer>
                        <ScrollViewer x:Name="RefactorScroll" Grid.Row="1" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed"><ContentControl x:Name="RefactorHost" /></ScrollViewer>
                        <StackPanel x:Name="RefactorActions" Grid.Row="3" Visibility="Collapsed" Margin="0,5,0,0">
                            <ContentControl x:Name="RefactorOptionsHost" />
                            <WrapPanel HorizontalAlignment="Right"><Button x:Name="RefactorRefreshButton" Content="Refresh" Click="RefreshRefactor" /><Button x:Name="RefactorStopButton" Content="Stop" IsEnabled="False" Click="StopRefactor" ToolTip="Let the current command finish, then stop before the next command." /><Button x:Name="RefactorDryRunButton" Content="Dry Run" IsEnabled="False" Click="DryRunRefactor" ToolTip="Check the selected command against Current without changing files. Prerequisite commands must already have run." /><Button x:Name="RefactorRunOneButton" Content="Run One" IsEnabled="False" Click="RunOneRefactor" ToolTip="Run the selected command, then stop." /><Button x:Name="RefactorRunAllButton" Content="Run All" IsEnabled="False" Click="RunAllRefactor" ToolTip="Run the queue from top to bottom, refreshing tags after each command." /></WrapPanel>
                        </StackPanel>
                        <ScrollViewer x:Name="ToolFormStatusScroll" Grid.Row="2" MaxHeight="72" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"><ContentControl x:Name="ToolFormStatusHost" /></ScrollViewer>
                        <Button Grid.Row="3" x:Name="PrimaryAction" IsEnabled="False" Content="Form available in Phase 4" Margin="0,5,0,0" Padding="8,5" Click="StartOperation" />
                    </Grid>
                </Border>
            </Grid>
        </GroupBox>
        <GroupBox Grid.Row="1" Header="Settings" Padding="8">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right">
                        <Button x:Name="EditorButton" Content="Tag Editor" Click="LaunchEditor" ToolTip="Launch invader-edit-qt using the selected editing kit's ordered tag roots." />
                        <Button Content="About" Click="About" />
                    </StackPanel>
                    <WrapPanel VerticalAlignment="Center">
                    <Button Content="Profiles…" Click="ManageProfiles" ToolTip="Create and edit editing kit profiles and paths." />
                    <ComboBox x:Name="ProfileSelector" ItemsSource="{Binding ProfileItems}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" DisplayMemberPath="Name" SelectionChanged="ProfileSelected" Width="160" ToolTip="Select the editing kit profile used for new tasks." />
                    <Button x:Name="ProjectFolderButton" Content="Open Editing Kit Folder" Click="OpenProject" ToolTip="Open the selected profile's Editing Kit Folder." />
                    <Button Content="Invader" Click="ManageInstallation" ToolTip="Choose the global Invader directory, rescan tools, or open its folder." />
                    <Button x:Name="ActivityButton" Content="Output Log" Click="ShowActivity" ToolTip="View task output, history, and cancellation controls." />
                    </WrapPanel>
                </DockPanel>
                <TextBlock x:Name="InstallationStatus" Margin="3,5,3,0" Text="Installation not configured" />
                <Button x:Name="RecoveryButton" Content="Configuration needs attention — open recovery" Click="OpenRecovery" HorizontalAlignment="Left" Visibility="Collapsed" />
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>


